\newlabel{fig:ry50}{{15}{18}{Estimated 50-year return period damages (USD millions) under four IPCC scenarios for 2030, 2045, and 2055. The gap between low and high emission scenarios widens over time}{figure.caption.17}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {16}{\ignorespaces Estimated 100-year return period damages (USD millions) under four IPCC scenarios for 2030, 2045, and 2055.}}{19}{figure.caption.18}\protected@file@percent }
\newlabel{fig:ry100}{{16}{19}{Estimated 100-year return period damages (USD millions) under four IPCC scenarios for 2030, 2045, and 2055}{figure.caption.18}{}}
